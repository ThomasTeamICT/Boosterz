  "doelen": [
{"id":"92541","code":"7.1.1","tekst":"<p>De leerlingen kunnen in bewegingscontexten motorische basisvaardigheden beheersen en in combinatie uitvoeren, gebruikmakend van diverse toestellen en materialen.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Grootmotorische en fysieke competenties","ordeningskader":{"type":"subthema"}}}}},
{"id":"92542","code":"7.1.2","tekst":"<p>De leerlingen kunnen in bewegingscontexten grootmotorische vaardigheden toepassen waaronder heffen en dragen, klimmen en klauteren, rijden en glijden, sluipen en kruipen, springen en landen, stappen en lopen, werpen, vangen en trappen, zwieren, balanceren en roteren in complexere bewegingssituaties.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Grootmotorische en fysieke competenties","ordeningskader":{"type":"subthema"}}}}},
{"id":"92543","code":"7.1.3","tekst":"<p>De leerlingen kunnen in bewegingscontexten de KLUSCE-componenten kracht, lenigheid, uithouding, snelheid, coördinatie, evenwicht voldoende lang toepassen (conform de bewegingsdriehoek).</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Grootmotorische en fysieke competenties","ordeningskader":{"type":"subthema"}}}}},
{"id":"92544","code":"7.1.4","tekst":"<p>De leerlingen kunnen in bewegingscontexten verschillende (aangepaste) sport-, spel- en bewegingsactiviteiten uitvoeren door zelfstandig oplossingen voor een bewegings- of spelprobleem te zoeken.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Grootmotorische en fysieke competenties","ordeningskader":{"type":"subthema"}}}}},
{"id":"92545","code":"7.1.5","tekst":"<p>De leerlingen kunnen in bewegingscontexten elementaire tactische principes demonstreren in aangepaste spelvormen (aanval, verdediging en omschakeling).</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Grootmotorische en fysieke competenties","ordeningskader":{"type":"subthema"}}}}},
{"id":"92547","code":"7.1.6","tekst":"<p>De leerlingen voelen zich veilig in het water en kunnen zwemmen zonder hulpmiddelen.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Grootmotorische en fysieke competenties","ordeningskader":{"type":"subthema"}}}}},
{"id":"92549","code":"7.1.7","tekst":"<p>De leerlingen kunnen in bewegingscontexten combinaties van bewegingen onthouden en zonder aanwijzingen uitvoeren volgens een opgelegd ritme.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Psychomotoriek (lichaamsperceptie, tijdsperceptie en ruimteperceptie)","ordeningskader":{"type":"subthema"}}}}},
{"id":"92550","code":"7.1.8","tekst":"<p>De leerlingen kunnen in bewegingscontexten bewegingen afstemmen op de ruimte (positie, afstand, richting, bewegingsbaan) in onvoorspelbare spelsituaties.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Psychomotoriek (lichaamsperceptie, tijdsperceptie en ruimteperceptie)","ordeningskader":{"type":"subthema"}}}}},
{"id":"92551","code":"7.1.9","tekst":"<p>De leerlingen kunnen in bewegingscontexten hun voorkeurslichaamszijde ontwikkelen en gericht inzetten bij bewegingsactiviteiten.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Psychomotoriek (lichaamsperceptie, tijdsperceptie en ruimteperceptie)","ordeningskader":{"type":"subthema"}}}}},
{"id":"92552","code":"7.1.10","tekst":"<p>De leerlingen kunnen in bewegingscontexten omgaan en rekening houden met de lichaamskenmerken, mogelijkheden en beperkingen van de ander.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Motorische competenties en fysieke competenties","ordeningskader":{"type":"onderwerp"}},"2":{"titel":"Psychomotoriek (lichaamsperceptie, tijdsperceptie en ruimteperceptie)","ordeningskader":{"type":"subthema"}}}}},
{"id":"92553","code":"7.2.1","tekst":"<p>De leerlingen kunnen deelnemen aan teamgericht spel en hierbij verschillende rollen aannemen.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Zelfconcept en interactie in groep","ordeningskader":{"type":"onderwerp"}}}}},
{"id":"92554","code":"7.2.2","tekst":"<p>De leerlingen kunnen de functie van scheidsrechter in vereenvoudigde spelvormen opnemen.</p>","type":"Te bereiken minimumdoelen op populatieniveau","extra":{"attitude":0,"geldigheid":{"type":"Geldig","geldig_van_dt":"2025-09-01T00:00:00Z","publicatie_dt":"2025-07-17T10:19:15Z"},"optioneel":false,"titels":{"1":{"titel":"Zelfconcept en interactie in groep","ordeningskader":{"type":"onderwerp"}}}}}
